NODE_ENV=development
PORT=3000
APP_NAME=Transit Backend
API_KEY=
INTERNAL_SERVICE_TOKEN=
# Set to "true" to enable internal OSM import + QA + cleanup endpoints
ENABLE_INTERNAL_ENDPOINTS=false
CORS_ORIGIN=http://localhost:3000
SWAGGER_ENABLED=true
DATABASE_URL=postgresql://transit:transit@localhost:5432/name_db?schema=public
REDIS_URL=redis://localhost:6379
POSTGRES_USER=user_db
POSTGRES_PASSWORD=password_db
POSTGRES_DB=postgresdb
POSTGRES_PORT=5432

# ── OSM / Overpass API ──────────────────────────────────
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT=30000

# ── MapTiler Geocoding ─────────────────────────────────
MAPTILER_API_KEY=
MAPTILER_GEOCODING_BASE_URL=https://api.maptiler.com

