NODE_ENV=development
PORT=3000
APP_NAME=Transit Backend
# ── (deprecated - JWT Bearer tokens replace x-api-key) ──
API_KEY=
INTERNAL_SERVICE_TOKEN=
# Set to "true" to enable internal OSM import + QA + cleanup endpoints
ENABLE_INTERNAL_ENDPOINTS=false
CORS_ORIGIN=http://localhost:3000
SWAGGER_ENABLED=true
LOG_LEVEL=info
DATABASE_URL=postgresql://transit:transit@localhost:5432/name_db?schema=public
REDIS_URL=redis://localhost:6379
POSTGRES_USER=user_db
POSTGRES_PASSWORD=password_db
POSTGRES_DB=postgresdb
POSTGRES_PORT=5432

# ── JWT Auth ──────────────────────────────────
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=90d

# ── Stadia Maps (Geocoding + Directions) ──────────────────
STADIAMAPS_API_KEY=
STADIAMAPS_BASE_URL=https://api.stadiamaps.com

# ── Object Storage (Backblaze B2 / S3-compatible) ──────────────────
STORAGE_ENDPOINT=https://s3.us-west-004.backblazeb2.com
STORAGE_REGION=us-west-004
STORAGE_APPLICATION_KEY_ID=
STORAGE_APPLICATION_KEY=
STORAGE_BUCKET_NAME=

# ── Google OAuth (ID Token verification) ──────────────────
GOOGLE_CLIENT_ID=

