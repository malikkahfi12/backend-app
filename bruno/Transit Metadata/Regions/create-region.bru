meta {
  name: Create Region
  type: http
  seq: 2
}

post {
  url: {{base_url}}/regions
  body: json
  auth: none
}

headers {
  x-api-key: {{api_key}}
  Content-Type: application/json
}

body:json {
  {
    "countryId": "country-id",
    "code": "jakarta",
    "name": "Jakarta",
    "timezone": "Asia/Jakarta",
    "defaultLocale": "id-ID"
  }
}
