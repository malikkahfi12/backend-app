meta {
  name: Dev Login
  type: http
  seq: 2
}

post {
  url: {{base_url}}/internal/auth/dev-login
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{internal_token}}
  Content-Type: application/json
}

body:json {
  {
    "username": "dev",
    "displayName": "Developer"
  }
}

vars:post-response {
  access_token: res.body.data.accessToken
  refresh_token: res.body.data.refreshToken
}
