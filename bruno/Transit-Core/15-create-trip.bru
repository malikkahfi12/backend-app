meta {
  name: Create Trip
  type: http
  seq: 15
}

post {
  url: {{base_url}}/trips
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
}

body:json {
  {
    "routeId": "{{route_id}}",
    "serviceId": "{{service_id}}",
    "headsign": "Kota",
    "directionId": 0,
    "blockId": "block-001",
    "isActive": true
  }
}
