meta {
  name: Create Stop Time
  type: http
  seq: 3
}

post {
  url: {{base_url}}/stop-times
  body: json
  auth: none
}

headers {
  x-api-key: {{api_key}}
  Content-Type: application/json
}

body:json {
  {
    "tripId": "trip-id",
    "stopId": "stop-id",
    "stopSequence": 1,
    "arrivalTime": "05:30:00",
    "departureTime": "05:30:30",
    "pickupType": 0,
    "dropOffType": 0
  }
}
