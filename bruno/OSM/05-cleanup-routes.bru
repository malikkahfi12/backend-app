meta {
  name: Cleanup Routes
  type: http
  seq: 5
}

post {
  url: {{base_url}}/internal/osm/cleanup/routes
  body: json
  auth: none
}

headers {
  x-api-key: {{api_key}}
  Authorization: Bearer {{internal_token}}
}

body:json {
  {
    "regionId": "{{osm_region_id}}",
    "removeDuplicateStops": true,
    "disableUnusable": false,
    "dryRun": true
  }
}
