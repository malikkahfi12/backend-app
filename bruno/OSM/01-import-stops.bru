meta {
  name: Import Stops
  type: http
  seq: 1
}

post {
  url: {{base_url}}/internal/osm/import/stops
  body: json
  auth: none
}

headers {
  x-api-key: {{api_key}}
  Authorization: Bearer {{internal_token}}
}

body:json {
  {
    "regionId": "{{osm_region_id}}",
    "bbox": "{{osm_bbox}}"
  }
}
