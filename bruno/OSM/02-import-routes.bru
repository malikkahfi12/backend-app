meta {
  name: Import Routes
  type: http
  seq: 2
}

post {
  url: {{base_url}}/internal/osm/import/routes
  body: json
  auth: none
}

headers {
  x-api-key: {{api_key}}
  Authorization: Bearer {{internal_token}}
}

body:json {
  {
    "regionId": "{{osm_region_id}}",
    "bbox": "{{osm_bbox}}",
    "modes": {{osm_modes}}
  }
}
