meta {
  name: Import GTFS
  type: http
  seq: 1
}

post {
  url: {{base_url}}/gtfs/import
  body: multipartForm
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

body:multipart-form {
  file: @file(/path/to/gtfs-feed.zip)
  source: transjakarta
  countryCode: ID
  regionCode: jakarta
}
