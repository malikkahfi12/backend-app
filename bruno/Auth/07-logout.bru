meta {
  name: 07 Logout
  type: http
  seq: 8
}

post {
  url: {{base_url}}/auth/logout
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "refreshToken": "{{refresh_token}}"
  }
}

docs {
  # 07 Logout — Revoke Current Session

  Revokes the current refresh token. The access token remains valid
  until it expires (max 15 min), but cannot be refreshed.

  ## Response
  {
    "success": true,
    "data": {
      "message": "Logged out successfully"
    }
  }

  ## Idempotent
  Calling logout multiple times with the same token always returns success.
  Already-revoked tokens return success without error.
}
