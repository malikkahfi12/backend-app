meta {
  name: 02 Login
  type: http
  seq: 3
}

post {
  url: {{base_url}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "challengeId": "{{challenge_id}}",
    "signature": "paste-base64url-signature-here"
  }
}

docs {
  # 02 Login — Complete Challenge with Signature

  Verifies the Ed25519 signature against the stored challenge
  using the device's public key. On success, issues access + refresh tokens.

  ## Response
  {
    "success": true,
    "data": {
      "user": { ... },
      "device": { ... },
      "accessToken": "eyJhbG...",
      "refreshToken": "dGVzdC..."
    },
    "meta": { "accessTokenExpiresIn": 900 }
  }

  ## After this request:
  1. Copy `data.accessToken` → {{access_token}}
  2. Copy `data.refreshToken` → {{refresh_token}}
}
