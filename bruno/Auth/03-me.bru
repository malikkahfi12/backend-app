meta {
  name: 03 Me
  type: http
  seq: 4
}

get {
  url: {{base_url}}/auth/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

docs {
  # 03 Me — Get Current Authenticated User

  Requires a valid JWT access token in the Authorization header.
  Returns the current user's profile with device context.

  ## Response
  {
    "success": true,
    "data": {
      "id": "uuid",
      "username": "malik",
      "displayName": "Malik",
      "avatarUrl": null,
      "avatarInitials": "M",
      "isActive": true,
      "deviceId": "uuid",
      "createdAt": "2025-05-29T12:00:00.000Z"
    }
  }

  ## Errors
  401 UNAUTHORIZED — Missing or malformed Bearer token
  401 INVALID_ACCESS_TOKEN — Token expired or invalid
  401 USER_INACTIVE — User account disabled
}
