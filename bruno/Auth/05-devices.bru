meta {
  name: 05 Devices
  type: http
  seq: 6
}

get {
  url: {{base_url}}/auth/devices
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

docs {
  # 05 Devices — List User Devices

  Lists all devices registered to the current user.
  The current device (from the JWT) is marked with `isCurrent: true`.

  ## Response
  {
    "success": true,
    "data": {
      "devices": [
        {
          "id": "uuid",
          "deviceName": "iPhone 17 Pro",
          "platform": "ios",
          "lastSeenAt": "2025-05-29T12:00:00.000Z",
          "createdAt": "2025-05-29T10:00:00.000Z",
          "isCurrent": true
        }
      ]
    }
  }

  ## After this request:
  Copy the `id` of a non-current device → {{device_id}} to revoke it in step 06.
}
